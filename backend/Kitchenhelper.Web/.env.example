# ==============================================
# KitchenHelper - Ortam Degiskenleri (ORNEK)
# ==============================================
# Bu dosyayi .env olarak kopyalayin ve degerleri doldurun:
#   copy .env.example .env
# ==============================================

# JWT Authentication
JWT_KEY=BURAYA_EN_AZ_32_KARAKTER_UZUNLUGUNDA_GIZLI_ANAHTAR_YAZIN
JWT_ISSUER=KitchenHelper
JWT_AUDIENCE=KitchenHelperApp

# OpenRouter AI API
OPENROUTER_API_KEY=BURAYA_OPENROUTER_API_KEY_YAZIN
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1/chat/completions
OPENROUTER_MODEL=google/gemini-2.0-flash-001

# Veritabani
CONNECTION_STRING=Data Source=kitchenhelper.db

# CORS - Izin verilen origin'ler (virguelle ayirin)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5039

# Dosya Yollari
FFMPEG_PATH=C:\ffmpeg\bin\ffmpeg.exe
FFPROBE_PATH=C:\ffmpeg\bin\ffprobe.exe
YTDLP_PATH=yt-dlp
UPLOADS_PATH=uploads

# Whisper ASR
WHISPER_MODEL=base
WHISPER_PYTHON_PATH=C:\Users\MSI\AppData\Local\Programs\Python\Python312\python.exe
WHISPER_SCRIPT_PATH=whisper_transcribe.py
