      }
    },
    {
      "order": 2,
      "text": "Add the red bell peppers to the side of the tray and roast them.",
      "timeHintMin": null,
      "flags": {
        "missingTime": true,
        "uncertainTemperature": false,
        "incomplete": false
      }
    },
    {
      "order": 3,
      "text": "Heat 3 tablespoons of vegetable oil in a pan and sauté the julienned onions and carrots separately.",
      "timeHintMin": null,
      "flags": {
        "missingTime": true,
        "uncertainTemperature": false,
        "incomplete": false
      }
    },
    {
      "order": 4,
      "text": "In a deep bowl, add the potatoes from the oven, the roasted red bell peppers (diced), and then the sautéed carrots and onions.",
      "timeHintMin": null,
      "flags": {
        "missingTime": true,
        "uncertainTemperature": false,
        "incomplete": false
      }
    },
    {
      "order": 5,
